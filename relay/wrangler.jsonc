{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hermes-multiplayer-relay",
  "main": "src/worker.js",
  "compatibility_date": "2025-06-01",
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "MultiplayerRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MultiplayerRoom"] }],
  "observability": { "enabled": true }
}
